# --- Upstream ---
# The WarEra host is FIXED at https://api2.warera.io. Do not change it in
# production; the server refuses a non-WarEra host unless
# WARERA_MCP_ALLOW_CUSTOM_UPSTREAM is explicitly enabled (local mocks only).
WARERA_MCP_ALLOW_CUSTOM_UPSTREAM=false
WARERA_MCP_WARERA_ORIGIN=https://app.warera.io

# --- Timeouts / limits ---
WARERA_MCP_CONNECT_TIMEOUT_SECONDS=2.0
WARERA_MCP_READ_TIMEOUT_SECONDS=6.0
WARERA_MCP_MAX_CONCURRENT_REQUESTS=8
# Full user-ranking snapshots can exceed 2 MB; tool output remains separately bounded.
WARERA_MCP_MAX_RESPONSE_BYTES=8000000
WARERA_MCP_MAX_RETRIES=2
# Hard wall-clock budget for one tool call (retries and fan-out included).
WARERA_MCP_TOOL_DEADLINE_SECONDS=12
# Upstream reads allowed to wait on the shared rate limiter; beyond this they are
# shed with a retryable RATE_LIMITED error instead of queueing.
WARERA_MCP_MAX_PENDING_REQUESTS=64

# --- GET batching (independent of caching) ---
WARERA_MCP_BATCHING_ENABLED=true
# Collection delay per independent stage; full batches send immediately.
WARERA_MCP_BATCH_WINDOW_SECONDS=0.3
WARERA_MCP_BATCH_MAX_SIZE=20
WARERA_MCP_BATCH_MAX_URL_BYTES=8000

# --- Public cache ---
WARERA_MCP_CACHE_ENABLED=true
WARERA_MCP_CACHE_MAX_ENTRIES=512

# --- Server ---
WARERA_MCP_HOST=127.0.0.1
WARERA_MCP_PORT=8000
WARERA_MCP_STATELESS_HTTP=true
WARERA_MCP_LOG_LEVEL=INFO
WARERA_MCP_LOG_JSON=true

# --- MCP client authentication (separate from WarEra credentials) ---
# Comma-separated bearer tokens accepted from MCP clients. Required when
# WARERA_MCP_REQUIRE_CLIENT_AUTH=true. Never put WarEra player credentials here.
WARERA_MCP_REQUIRE_CLIENT_AUTH=false
WARERA_MCP_CLIENT_AUTH_TOKENS=
# Allowed Host header values (enables DNS-rebinding protection). Set this whenever
# the server is reachable on a non-loopback address, e.g. mcp.example.com
WARERA_MCP_TRUSTED_HOSTS=
# Number of trusted reverse proxies in front of the server. With 0 (default)
# X-Forwarded-For is ignored and the rate limit is keyed on the peer address.
WARERA_MCP_TRUSTED_PROXY_HOPS=0

# NOTE: WarEra player API keys and JWTs are NOT deployment secrets and are never
# configured here. They are request-scoped tool arguments only.
